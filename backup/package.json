{
  "name": "nightwatch-testsuite",
  "version": "1.0.0",
  "description": "E2E Testing Suite using Nightwatch.js",
  "main": "index.js",
  "scripts": {
    "clean": "rimraf tests_output/*",
    "pretest": "npm run clean",
    "test": "nightwatch --env safari",
    "test:safari": "nightwatch --env safari",
    "test:chrome": "nightwatch --env chrome",
    "test:firefox": "nightwatch --env firefox",
    "test:headless": "nightwatch --env headless",
    "test:login": "nightwatch src/tests/e2e/testTodoistLogin.spec.js --env safari",
    "test:parallel": "nightwatch --env safari,chrome,firefox --parallel",
    "test:single": "nightwatch --testcase --env safari",
    "test:ci": "nightwatch --env headless --parallel",
    "report": "node config/html-reporter/html-reporter.js",
    "report:open": "npm run report && open tests_output/report.html",
    "safaridriver:setup": "sudo safaridriver --enable",
    "lint": "eslint . --ext .js,.ts",
    "lint:fix": "eslint . --ext .js,.ts --fix",
    "format": "prettier --write \"**/*.{js,ts,json,md}\"",
    "validate": "npm run lint && npm run test:headless"
  },
  "keywords": [
    "nightwatch",
    "e2e",
    "testing",
    "automation"
  ],
  "author": "Carlos Cervantes",
  "license": "MIT",
  "dependencies": {
    "nightwatch-html-reporter": "^2.0.6"
  },
  "devDependencies": {
    "@types/nightwatch": "^2.3.30",
    "@typescript-eslint/eslint-plugin": "^6.9.1",
    "@typescript-eslint/parser": "^6.9.1",
    "chromedriver": "^119.0.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "eslint": "^8.52.0",
    "geckodriver": "^4.3.0",
    "handlebars": "^4.7.8",
    "mocha": "^10.2.0",
    "nightwatch": "^2.6.21",
    "prettier": "^3.0.3",
    "rimraf": "^5.0.5",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "volta": {
    "node": "18.18.2",
    "npm": "10.2.1"
  }
}
